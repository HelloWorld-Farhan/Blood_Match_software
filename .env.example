# Production Render Backend API URL
VITE_BACKEND_URL=https://blood-match-backend.onrender.com
VITE_API_URL=https://blood-match-backend.onrender.com

# Supabase Database & Auth API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-jwt-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Cloudflare R2 Object Storage
VITE_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Autonomous Google Apps Script Webhook
VITE_GOOGLE_APP_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
